{
  "name": "nailong-city",
  "version": "0.3.2",
  "type": "module",
  "private": true,
  "description": "Third-person open-city crime sandbox starring a cheerful yellow dragon, with driving, gunplay, police chases, shops, day-night cycle and a five-mission story.",
  "author": "Nailong City contributors",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win portable --x64",
    "test": "node --test tests/*.test.mjs",
    "test:visual": "node scripts/smoke.mjs",
    "test:electron": "node scripts/electron-check.mjs"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "lucide": "^0.577.0",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.58.0",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "dev.nailong.city",
    "productName": "Nailong City",
    "electronDist": "node_modules/electron/dist",
    "artifactName": "Nailong-City-${version}-${arch}.${ext}",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "assets/**/*", "LICENSE", "README.md", "package.json"],
    "asar": true,
    "win": { "target": "portable", "icon": "assets/icon.ico", "signExecutable": false }
  }
}
